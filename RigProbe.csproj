<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SimConnect.dll solo existe en 64 bits. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- SDK de MSFS 2024: variable MSFS2024_SDK (la crea el instalador) o la ruta por defecto. -->
  <PropertyGroup>
    <MsfsSdk Condition="'$(MSFS2024_SDK)' != ''">$([MSBuild]::EnsureTrailingSlash('$(MSFS2024_SDK)'))</MsfsSdk>
    <MsfsSdk Condition="'$(MsfsSdk)' == ''">C:\MSFS 2024 SDK\</MsfsSdk>
    <SimConnectDll>$(MsfsSdk)SimConnect SDK\lib\SimConnect.dll</SimConnectDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
  </ItemGroup>

  <!-- La DLL nativa se copia junto al ejecutable; sin el SDK se compila igual y las acciones K:/B:/L: avisan. -->
  <ItemGroup Condition="Exists('$(SimConnectDll)')">
    <None Include="$(SimConnectDll)" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="AvisoSimConnect" BeforeTargets="Build" Condition="!Exists('$(SimConnectDll)')">
    <Warning Text="No se encuentra $(SimConnectDll): instala el SDK de MSFS 2024 o define MSFS2024_SDK. Sin ella no hay salida a MSFS." />
  </Target>

</Project>
