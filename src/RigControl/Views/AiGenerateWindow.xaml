<Window x:Class="RigControl.Views.AiGenerateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generar perfil con IA" Width="760" Height="820" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Generar perfil con IA" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0"
                       Text="Claude escribe un borrador con tus mandos (catálogo, ia-notas.md y tus perfiles), los controles del avión y lo que pidas. Se valida solo y se abre en el editor: no se guarda hasta que pulses Guardar." />

            <!-- Clave -->
            <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Olvidar clave" Click="ForgetKey_Click"
                                Visibility="{Binding HasKey, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding KeyText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVisibility}}">
                        <Button DockPanel.Dock="Right" Content="Guardar clave" Click="SaveKey_Click" Margin="8,0,0,0" />
                        <PasswordBox x:Name="KeyBox" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Simulador" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Avión" FontWeight="SemiBold" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding SimNames}" SelectedItem="{Binding SimName}" IsEnabled="{Binding NotBusy}" />
                <ComboBox Grid.Column="2" IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding AircraftSuggestions}"
                          Text="{Binding Aircraft, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                          IsEnabled="{Binding NotBusy}" />
                <Button Grid.Column="3" Content="Usar el avión actual" Click="Detect_Click" Margin="8,0,0,0"
                        IsEnabled="{Binding NotBusy}" />
            </Grid>
            <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0" Text="{Binding AircraftHint}" />
            <TextBlock Margin="0,2,0,0" Text="{Binding AircraftInfo}" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                        <Setter Property="Opacity" Value="0.9" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AircraftInfo}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Style="{StaticResource Label}" Text="Partir de" />
            <ComboBox ItemsSource="{Binding BaseProfiles}" SelectedItem="{Binding BaseProfile}" />
            <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0"
                       Text="Al modificar un perfil, Guardar en el editor lo sobrescribe (queda la copia .json.bak)." />

            <TextBlock Style="{StaticResource Label}" Text="Qué quieres" />
            <TextBox Text="{Binding Preferences, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="90" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                     ToolTip="Por ejemplo: &quot;Luces exteriores y radios en el hat de la izquierda del Moza; master caution en el PTO 2&quot;." />
        </StackPanel>

        <!-- Progreso y resultado -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Progress}" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                <!-- Claude pide abrir el simulador -->
                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="6" BorderThickness="2"
                        BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                        Visibility="{Binding WaitingForSim, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SimAsk}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Seguir sin él" Click="SimSkip_Click" Margin="0,0,8,0" />
                            <Button Content="Ya está" Click="SimReady_Click" MinWidth="90" Style="{DynamicResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <StackPanel>
                    <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                             Background="Transparent" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
                    <TextBox Text="{Binding Validation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                             Background="Transparent" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0"
                    Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="✨  Generar" Click="Generate_Click" Margin="0,0,8,0" MinWidth="110" IsEnabled="{Binding CanGenerate}" />
            <Button Content="Abrir en el editor" Click="Open_Click" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding NotBusy}" />
            <Button Content="Cerrar" Click="Close_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
