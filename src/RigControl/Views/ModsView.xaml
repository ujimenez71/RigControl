<UserControl x:Class="RigControl.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Grid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="Mods" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap">
                <Run Text="Los mods viven en una biblioteca; activar uno es poner un enlace en la carpeta del simulador (al instante, sin copiar). Nunca se borra un mod. Se guarda en " /><Run Text="{Binding FilePath, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
            </TextBlock>
        </StackPanel>

        <!-- Bibliotecas y conjuntos -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top" Text="Bibliotecas" Style="{StaticResource SectionTitle}" />
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}" DisplayMemberPath="Name"
                     MaxHeight="170" Margin="0,0,0,16" />

            <TextBlock DockPanel.Dock="Top" Text="Conjuntos" Style="{StaticResource SectionTitle}" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" IsEnabled="{Binding CanEdit}">
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Aplicar" Click="ApplySet_Click" Margin="0,0,6,0" IsEnabled="{Binding HasSet}"
                            ToolTip="Deja activos los mods del conjunto (y los marcados «Siempre») y desactiva el resto de cada biblioteca que incluye. Lo suelto no se toca." />
                    <Button Content="Borrar" Click="RemoveSet_Click" IsEnabled="{Binding HasSet}" />
                </WrapPanel>
                <TextBlock Text="Nuevo conjunto con lo activo ahora" Opacity="0.7" Margin="0,4,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Crear" Click="CreateSet_Click" Margin="6,0,0,0" />
                    <TextBox Text="{Binding NewSetName, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" DisplayMemberPath="Name"
                     ToolTip="Elige un conjunto para verlo y editarlo con la columna «En el conjunto». Los hangares pueden aplicarlo antes de abrir el simulador." />
        </DockPanel>

        <!-- Mods de la biblioteca elegida -->
        <DockPanel Grid.Row="1" Grid.Column="1" Visibility="{Binding HasLibrary, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding LibraryText}" Opacity="0.7" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding LockText}" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="{Binding ImportText}" Click="Import_Click" IsEnabled="{Binding CanChange}"
                        ToolTip="Mueve a la biblioteca las carpetas de verdad que hay en el destino y deja un enlace en su sitio: siguen activas. Misma unidad = solo se renombran." />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
            </DockPanel>

            <DataGrid ItemsSource="{Binding Mods}" Style="{StaticResource Grid}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Activo" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}"
                                          MinWidth="0" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="3*" />
                    <DataGridTemplateColumn Header="Estado" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StateText}" ToolTip="{Binding Detail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0.75" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                    <Setter Property="Foreground" Value="OrangeRed" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Siempre" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Always, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding InLibrary}"
                                          MinWidth="0" HorizontalAlignment="Center"
                                          ToolTip="Todos los conjuntos lo dejan activo (p. ej. Navigraph o el módulo de WinWing)." />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="En el conjunto" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding InSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" HorizontalAlignment="Center"
                                          IsEnabled="{Binding DataContext.HasSet, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ToolTip="{Binding DataContext.InSetHeader, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Message}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
