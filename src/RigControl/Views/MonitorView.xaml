<UserControl x:Class="RigControl.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RigControl.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="200" MinHeight="80" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Reabrir dispositivos" Click="Reopen_Click" Margin="8,0,0,0"
                        ToolTip="Vuelve a detectar y abrir los mandos (p. ej. tras conectar uno)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Monitor de entradas" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Lista de dispositivos + detalle del seleccionado -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.65" />
                            </StackPanel>
                            <!-- Punto de actividad: se enciende al tocar un control de ese mando -->
                            <Ellipse Grid.Column="1" Width="10" Height="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Column="1" Text="sin señal" FontSize="11" Foreground="OrangeRed"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Opacity="0.7">
                        <Run Text="{Binding ProductName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Key, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Ejes -->
                    <TextBlock Text="Ejes" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <TextBlock Text="Este dispositivo no tiene ejes." Opacity="0.6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Axes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Axes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AxisViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                 Height="10" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Raw}" TextAlignment="Right" Opacity="0.55"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Hats -->
                    <TextBlock Text="Hats" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hats.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Hats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HatViewModel}">
                                <Border Padding="12,6" Margin="0,0,8,8" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <TextBlock FontSize="14">
                                        <Run Text="Hat" /><Run Text="{Binding Number, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Text, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Botones -->
                    <TextBlock Text="Botones" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding Buttons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ButtonViewModel}">
                                <Border Width="40" Height="30" Margin="0,0,4,4" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Height="4" VerticalAlignment="Center" Background="Transparent" />

        <!-- Registro de cambios (lo mismo que imprimía "RigProbe monitor") -->
        <DockPanel Grid.Row="3">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Content="Pausar registro" IsChecked="{Binding Paused}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Content="Limpiar" Click="ClearLog_Click" />
                </StackPanel>
                <TextBlock Text="Registro de cambios (lo más reciente arriba)" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Log}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     ItemContainerStyle="{StaticResource LogItem}"
                     VirtualizingPanel.IsVirtualizing="True" />
        </DockPanel>
    </Grid>
</UserControl>
