<UserControl x:Class="RigControl.Views.ProfileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RigControl.ViewModels"
             xmlns:b="clr-namespace:RigControl.Core.Bindings;assembly=RigControl.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Editor de una condición (de un binding o de una capa): todas / alguna de varias piezas -->
        <DataTemplate x:Key="ConditionEditor" DataType="{x:Type vm:ConditionEditViewModel}">
            <StackPanel>
                <ComboBox ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Mode}"
                          Visibility="{Binding IsNotComplex, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Visibility="{Binding IsComplex, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Hint}" Text="Condición anidada (más compleja de lo que el editor sabe mostrar): se conserva tal cual." />
                    <TextBlock Text="{Binding ComplexText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,4" />
                    <Button Content="Quitar esta condición" Click="ClearComplex_Click" HorizontalAlignment="Left"
                            Style="{StaticResource SmallButton}" />
                </StackPanel>
                <StackPanel Visibility="{Binding ShowTerms, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Terms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConditionTermViewModel}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox Content="NO" IsChecked="{Binding Negate}" VerticalAlignment="Center" Margin="0,0,6,0"
                                              ToolTip="Niega la pieza: se cumple cuando la entrada NO se mantiene / la capa NO está activa" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ConditionEditViewModel.Kinds}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Kind}" />
                                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                               Visibility="{Binding IsInput, Converter={StaticResource BoolToVisibility}}">
                                        <Button DockPanel.Dock="Right" Content="🎯" Click="CaptureTerm_Click" Margin="4,0,0,0"
                                                Style="{StaticResource SmallButton}" ToolTip="Capturar: pulsa el botón del mando" />
                                        <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                                                 ToolTip="alias:b5, alias:hat1.up o alias:y&gt;90" />
                                    </DockPanel>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" SelectedItem="{Binding Layer}"
                                              ItemsSource="{Binding DataContext.LayerNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Visibility="{Binding IsLayer, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="2" Content="✕" Click="RemoveTerm_Click" Margin="4,0,0,0"
                                            Style="{StaticResource SmallButton}" ToolTip="Quitar esta pieza" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="＋ Añadir pieza" Click="AddTerm_Click" HorizontalAlignment="Left" Style="{StaticResource SmallButton}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra: guardar / descartar / estado -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Descartar" Click="Discard_Click" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="💾  Guardar" Click="Save_Click" MinWidth="110"
                    Style="{StaticResource AccentButton}" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Status}" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#22A447" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter Property="Foreground" Value="#D9342B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Datos del perfil -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="Nombre" Style="{StaticResource Label}" Margin="0,0,0,4" />
            <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Text="Simulador" Style="{StaticResource Label}" Margin="0,0,0,4" />
            <ComboBox Grid.Column="2" Grid.Row="1" ItemsSource="{x:Static vm:ProfileEditorViewModel.SimOptions}"
                      SelectedItem="{Binding Sim}" />
            <TextBlock Grid.Column="4" Style="{StaticResource Label}" Margin="0,0,0,4"
                       Text="Aviones (separados por comas; trozos de la ruta en MSFS, dcs:nombre en DCS)" />
            <DockPanel Grid.Column="4" Grid.Row="1">
                <Button DockPanel.Dock="Right" Content="Usar el avión actual" Click="UseAircraft_Click" Margin="8,0,0,0"
                        ToolTip="Añade el avión cargado ahora en MSFS o DCS" />
                <TextBox Text="{Binding AircraftText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <DockPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Notas" Style="{StaticResource Label}" Margin="0,6,12,0" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                         MaxHeight="60" VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>

        <TabControl Grid.Row="2">
        <!-- Bindings + panel de edición -->
        <TabItem Header="{Binding BindingsHeader}">
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="＋  Añadir" Click="Add_Click" Margin="0,0,8,0"
                            ToolTip="Nuevo binding: pulsa después el botón del mando que quieras asignar" />
                    <Button Content="Duplicar" Click="Duplicate_Click" Margin="0,0,8,0" />
                    <Button Content="Borrar" Click="Delete_Click" />
                    <TextBlock Text="{Binding SimStatus}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11" Opacity="0.6"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DataGrid x:Name="BindingsGrid" ItemsSource="{Binding Bindings}" SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Single" CanUserSortColumns="False" CanUserReorderColumns="False" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Entrada" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:BindingEditViewModel}">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding InputText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TriggerDetail}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Acción" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:BindingEditViewModel}">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Action}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                   Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Se envía a" Binding="{Binding KindText}" Width="1.3*" />
                        <DataGridTemplateColumn Header="" Width="28">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:BindingEditViewModel}">
                                    <TextBlock Text="⚠" Foreground="#D9342B" ToolTip="{Binding Error}" VerticalAlignment="Center"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Panel de edición del binding seleccionado -->
            <Border Grid.Column="2" Padding="16,4,16,12" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <Grid>
                    <TextBlock Text="Selecciona un binding o pulsa Añadir." Opacity="0.6" Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DataContext="{Binding Selected}">
                            <!-- Entrada -->
                            <TextBlock Text="ENTRADA" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding InputText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Visibility="{Binding IsNotSequence, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="110" Click="Capture_Click"
                                            Content="{Binding DataContext.CaptureButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource AccentButton}" />
                                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Mono, Consolas"
                                             ToolTip="alias:b12 (botón), alias:hat1.up (hat), alias:y&gt;90 (zona de eje en %)" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{Binding DataContext.CaptureStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBlock Text="Gesto" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{x:Static vm:BindingEditViewModel.Gestures}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding Gesture}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Visibility="{Binding IsSequence, Converter={StaticResource BoolToVisibility}}"
                                       Text="Secuencia: las entradas no se editan aquí (se conservan tal cual)." />
                            <TextBlock Text="Condición" Style="{StaticResource Label}" />
                            <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource ConditionEditor}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Con un modificador: «Se mantiene la entrada» + el botón que harás de shift. Las capas se definen en su pestaña." />

                            <!-- Acción -->
                            <TextBlock Text="ACCIÓN" Style="{StaticResource Label}" Margin="0,18,0,4" />
                            <TextBlock Text="Se envía a" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:BindingEditViewModel.Targets}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding Target}" />
                            <TextBlock Text="{Binding TargetHelp}" Style="{StaticResource Hint}" />

                            <TextBlock Text="{Binding NameLabel}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                                     Visibility="{Binding IsNotKey, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Text="{Binding Name, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" IsReadOnly="True"
                                     PreviewKeyDown="KeyCapture_PreviewKeyDown" IsReadOnlyCaretVisible="False"
                                     ToolTip="Haz clic aquí y pulsa la tecla o combinación (p. ej. Ctrl+Shift+G)"
                                     Visibility="{Binding IsKey, Converter={StaticResource BoolToVisibility}}" />
                            <ListBox ItemsSource="{Binding DataContext.Suggestions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     MaxHeight="150" Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                     MouseLeftButtonUp="Suggestion_Click" ToolTip="Haz clic en una para usarla; escribe arriba para filtrar">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Suggestions.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                            </ListBox>

                            <StackPanel Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Valor" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock Text="{Binding ValueHint}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding DataContext.DcsValueHelp, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Style="{StaticResource Hint}" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowRepeat, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Repetir cada (ms)" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding RepeatMs, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Vacío = se envía una vez al pulsar. Con un número, se repite mientras lo mantienes (p. ej. 50 para el trim)."
                                           Style="{StaticResource Hint}" />
                            </StackPanel>

                            <TextBlock Text="Descripción (opcional)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Desc, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="Si la dejas vacía: " /><Run Text="{Binding AutoDescription, Mode=OneWay}" FontStyle="Italic" />
                            </TextBlock>

                            <TextBlock Text="Resultado" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Action}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Error}" Foreground="#D9342B" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        </TabItem>

        <!-- Capas: condiciones con nombre -->
        <TabItem Header="{Binding LayersHeader}">
            <DockPanel Margin="0,8,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Content="＋  Nueva capa" Click="NewLayer_Click" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"
                               Text="Una capa es una condición con nombre (p. ej. «shift» = un botón mantenido) que luego usas en las condiciones de los bindings con «Está activa la capa». Al renombrarla se actualizan los bindings que la usan." />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Layers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LayerEditViewModel}">
                                <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Borrar" Click="DeleteLayer_Click" Style="{StaticResource SmallButton}" />
                                            <TextBlock Text="Nombre" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="220" HorizontalAlignment="Left"
                                                     FontWeight="SemiBold" ToolTip="Se aplica al salir del campo" />
                                        </DockPanel>
                                        <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource ConditionEditor}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- Luces del Bravo -->
        <TabItem Header="{Binding LightsHeader}">
            <DockPanel Margin="0,8,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Content="＋  Nueva luz" Click="NewLight_Click" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"
                               Text="Cada luz se enciende cuando se cumplen todas sus condiciones. Con MSFS abierto, cada condición enseña su valor actual y la luz si se encendería ahora. Unidades vacías = Number (p. ej. Volts, psi, percent, inHg, Amperes)." />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LightEditViewModel}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Borrar" Click="DeleteLight_Click" Style="{StaticResource SmallButton}" />
                                            <ComboBox ItemsSource="{x:Static vm:LightEditViewModel.LedNames}" SelectedItem="{Binding Led}"
                                                      Width="180" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LiveState}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LiveOn}" Value="True">
                                                                <Setter Property="Foreground" Value="#22A447" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <!-- Títulos de las columnas (mismas medidas que las filas) -->
                                        <Grid Margin="0,0,0,2" Opacity="0.6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="3*" MinWidth="200" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="152" />
                                                <ColumnDefinition Width="1.2*" MinWidth="110" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Variable" FontSize="11" />
                                            <TextBlock Grid.Column="2" Text="Unidades" FontSize="11" />
                                            <TextBlock Grid.Column="3" Text="Se cumple si es" FontSize="11" />
                                            <TextBlock Grid.Column="4" Text="Valor" FontSize="11" />
                                            <TextBlock Grid.Column="5" Text="En vivo (MSFS)" FontSize="11" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Terms}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LightTermViewModel}">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="62" />
                                                            <ColumnDefinition Width="3*" MinWidth="200" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="152" />
                                                            <ColumnDefinition Width="1.2*" MinWidth="110" />
                                                            <ColumnDefinition Width="32" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Texto libre si el del JSON no encaja en las partes -->
                                                        <TextBox Grid.ColumnSpan="6" Text="{Binding Raw, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontFamily="Cascadia Mono, Consolas"
                                                                 Visibility="{Binding IsRaw, Converter={StaticResource BoolToVisibility}}" />
                                                        <CheckBox Content="NO" IsChecked="{Binding Negate}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                  ToolTip="Niega la condición"
                                                                  Visibility="{Binding IsParts, Converter={StaticResource BoolToVisibility}}" />
                                                        <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{x:Static vm:LightTermViewModel.CommonVars}"
                                                                  Text="{Binding Variable, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"
                                                                  FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                                  ToolTip="A:VARIABLE (simvar de MSFS, con :índice si hace falta) o L:Variable"
                                                                  Visibility="{Binding IsParts, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBox Grid.Column="2" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                                                 ToolTip="Unidades: vacío = Number; Volts, psi, percent, inHg, Amperes..."
                                                                 Visibility="{Binding IsParts, Converter={StaticResource BoolToVisibility}}" />
                                                        <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LightTermViewModel.Compares}" DisplayMemberPath="Label"
                                                                  SelectedValuePath="Value" SelectedValue="{Binding Compare}" Margin="0,0,6,0"
                                                                  Visibility="{Binding IsParts, Converter={StaticResource BoolToVisibility}}" />
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,6,0"
                                                                    Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                                            <TextBlock Text=" y " VerticalAlignment="Center"
                                                                       Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBox Text="{Binding Value2, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                                     Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="5" Text="{Binding Live}" VerticalAlignment="Center" FontSize="11" Opacity="0.75"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="6" Content="✕" Click="RemoveLightTerm_Click" Style="{StaticResource SmallButton}"
                                                                ToolTip="Quitar esta condición" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="＋ Añadir condición" Click="AddLightTerm_Click" HorizontalAlignment="Left"
                                                Style="{StaticResource SmallButton}" />
                                        <TextBlock Text="{Binding Error}" Foreground="#D9342B" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        </TabControl>

        <!-- Problemas del perfil completo -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Problems}" Margin="0,8,0,0" MaxHeight="110">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProblemItem}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,1">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Opacity" Value="0.7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static b:Severity.Error}">
                                        <Setter Property="Foreground" Value="#D9342B" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static b:Severity.Warning}">
                                        <Setter Property="Foreground" Value="#C27C0E" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="•" /> <Run Text="{Binding Text, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
