<UserControl x:Class="RigControl.Views.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Grid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="Wrap" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cabecera -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="{Binding HeadsetName}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding RefreshHz}" MinWidth="90"
                          ToolTip="Refresco con el que vuelas (Pimax Play). Las reglas de VR comparan con él el límite de FPS.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock><Run Text="{Binding Mode=OneWay}" /><Run Text=" Hz" /></TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Abrir graficos.json" Click="OpenFile_Click" Margin="8,0,0,0" />
                <Button Content="Recargar" Click="Reload_Click" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="Perfiles de ajustes gráficos de DCS (options.lua y autoexec.cfg) y MSFS 2024 (UserCfg.opt) pensados para VR. Aplicar solo con el simulador cerrado; antes se guarda una copia .bak del archivo. Cada hangar puede aplicar uno al abrirse." />
            </StackPanel>
        </DockPanel>

        <!-- Revisión de lo actual -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="12,8" CornerRadius="6" BorderThickness="1" Margin="0,0,0,8"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel>
                <TextBlock Text="Ahora, revisado para VR" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CurrentReview}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PathsText}" FontSize="11" Opacity="0.6" Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas" />
            </StackPanel>
        </Border>

        <!-- Perfiles + guardar lo actual -->
        <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
            <Border DockPanel.Dock="Bottom" Padding="10" CornerRadius="6" BorderThickness="1" Margin="0,8,0,0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <StackPanel>
                    <TextBlock Text="Guardar lo actual como perfil" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding SimNames}" SelectedItem="{Binding NewSim}" Margin="0,6,0,0" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                             ToolTip="Nombre del perfil, p. ej. «VR helicópteros» o «VR multijugador»" />
                    <CheckBox Content="Para VR" IsChecked="{Binding NewVr}" Margin="0,6,0,0"
                              ToolTip="En MSFS guarda solo los ajustes de VR (sin marcar: los del monitor). En DCS se revisa con las reglas de VR." />
                    <Button Content="Guardar" Click="Capture_Click" Margin="0,6,0,0" HorizontalAlignment="Left" IsEnabled="{Binding CanCapture}" />
                </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Perfil elegido / medición -->
        <TabControl Grid.Row="2" Grid.Column="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Perfil">
                <Grid Margin="0,8,0,0">
                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Aplicar" Click="Apply_Click" MinWidth="100" Margin="0,0,8,0" IsEnabled="{Binding CanApply}"
                                        Style="{DynamicResource AccentButtonStyle}" />
                                <Button Content="Borrar" Click="Delete_Click" />
                            </StackPanel>
                            <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedNotes}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding ProfileAdvice}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Aviso">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Section}" Text="Qué cambiaría al aplicarlo" />
                        <TextBlock Text="Ya está aplicado: los ajustes actuales son los del perfil." Opacity="0.7"
                                   Visibility="{Binding NoChanges, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Changes}" Style="{StaticResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ajuste" Binding="{Binding Key}" Width="2*" FontFamily="Cascadia Mono, Consolas" />
                            <DataGridTextColumn Header="Ahora" Binding="{Binding CurrentText}" Width="*" />
                            <DataGridTextColumn Header="Perfil" Binding="{Binding WantedText}" Width="*" FontWeight="SemiBold" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <TextBlock Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top"
                           Text="Aún no hay perfiles. Deja el simulador como te guste, ciérralo y guarda lo actual como perfil (abajo a la izquierda)."
                           Visibility="{Binding NoSelection, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem Header="Medir FPS en DCS">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                   Text="DCS se abre solo, vuela una misión de prueba en el Caucaso (ciudad, aeródromo y nubes, ~25 s cada una) y se cierra: unos 5 minutos sin tocar el ordenador. Tu options.lua y autoexec.cfg quedan como estaban, pase lo que pase. En VR, el visor encendido y despierto (puesto sin moverte o con el sensor de proximidad tapado); mejor sin Smart Smoothing." />
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="Medir" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding MeasureOptions}" SelectedIndex="{Binding MeasureIndex}" MinWidth="220"
                                      IsEnabled="{Binding NotMeasuring}" />
                            <CheckBox Content="En VR" IsChecked="{Binding MeasureVr}" Margin="16,0,0,0" VerticalAlignment="Center"
                                      IsEnabled="{Binding NotMeasuring}"
                                      ToolTip="Sin marcar: en el monitor, sin límite de FPS ni sincronización (para comparar costes)." />
                            <Button Content="▶  Medir" Click="Measure_Click" Margin="16,0,0,0" MinWidth="100" Style="{DynamicResource AccentButtonStyle}"
                                    IsEnabled="{Binding CanMeasure}" />
                            <Button Content="🔧  Optimizar en VR" Click="Optimize_Click" Margin="8,0,0,0" IsEnabled="{Binding CanMeasure}"
                                    ToolTip="Prueba subir o bajar cada ajuste en VR y propone la mejor configuración que llega al refresco del visor (15-20 min). Guarda un perfil nuevo sin aplicarlo." />
                            <Button Content="■  Cancelar" Click="CancelMeasure_Click" Margin="8,0,0,0"
                                    Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                                     Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <!-- Progreso: alto limitado, con barra propia y siempre en la última línea. -->
                    <ScrollViewer Grid.Row="1" x:Name="LogScroll" MaxHeight="150" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" ScrollChanged="LogScroll_ScrollChanged">
                        <ItemsControl ItemsSource="{Binding MeasureLog}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Resultado del optimizador: recomendación, consejos y todas las pruebas, con su barra. -->
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="12,8" CornerRadius="6" BorderThickness="2"
                            BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                            Visibility="{Binding HasOptimizeSummary, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding OptimizeSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                 Background="Transparent" MaxHeight="340" VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <StackPanel Grid.Row="3">
                        <TextBlock Style="{StaticResource Section}" Text="Mediciones" />
                        <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                                   Text="«Fuera de tiempo» = fotogramas que no llegan al refresco del visor (+10 %): es lo que se nota en VR. «1 % bajo» = FPS en el percentil 99." />
                    </StackPanel>
                    <DataGrid Grid.Row="4" ItemsSource="{Binding Measurements}" Style="{StaticResource Grid}" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cuándo" Binding="{Binding When}" Width="Auto" />
                            <DataGridTextColumn Header="Modo" Binding="{Binding Mode}" Width="Auto" />
                            <DataGridTextColumn Header="Configuración" Binding="{Binding Profile}" Width="*" ElementStyle="{StaticResource Wrap}" />
                            <DataGridTextColumn Header="FPS" Binding="{Binding Avg}" Width="Auto" />
                            <DataGridTextColumn Header="1 % bajo" Binding="{Binding Low}" Width="Auto" />
                            <DataGridTextColumn Header="Fuera de tiempo" Binding="{Binding Missed}" Width="Auto" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Tirones" Binding="{Binding Stutters}" Width="Auto" />
                            <DataGridTextColumn Header="Por escena" Binding="{Binding PerScene}" Width="1.6*" ElementStyle="{StaticResource Wrap}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Vuelos en VR" x:Name="FlightsTab">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Cada sesión de juego en el visor, tal como la resume Pimax Play al cerrar el juego: vale también para tus vuelos normales, sin instalar nada. «Mediana» = FPS más habituales; «5 % bajo» = FPS en los peores momentos; «&lt; 50 FPS» = tiempo a la mitad del refresco (Smart Smoothing), en cargas o en menús. Pimax cuenta los menús y las cargas, así que la mediana dice más que la media. RigControl guarda su propio historial (Pimax borra los registros viejos)." />
                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button Content="↻  Actualizar" Click="RefreshFlights_Click" MinWidth="110" />
                        <CheckBox Content="Solo vuelos (sin sesiones cortas, sin imagen ni mediciones de RigControl)" IsChecked="{Binding OnlyFlights}"
                                  Margin="16,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FlightsInfo}" Opacity="0.7" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Flights}" Style="{StaticResource Grid}" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Inicio" Binding="{Binding When}" Width="Auto" />
                            <DataGridTextColumn Header="Juego" Binding="{Binding Game}" Width="Auto" />
                            <DataGridTextColumn Header="Duración" Binding="{Binding Duration}" Width="Auto" />
                            <DataGridTextColumn Header="Visor" Binding="{Binding Hz}" Width="Auto" />
                            <DataGridTextColumn Header="Mediana" Binding="{Binding Median}" Width="Auto" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="5 % bajo" Binding="{Binding P5}" Width="Auto" />
                            <DataGridTextColumn Header="&lt; 50 FPS" Binding="{Binding Below50}" Width="Auto" />
                            <DataGridTextColumn Header="GPU" Binding="{Binding Gpu}" Width="Auto">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="ToolTip" Value="{Binding GpuDetail}" />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="*" MinWidth="140" ElementStyle="{StaticResource Wrap}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
