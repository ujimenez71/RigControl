<Window x:Class="RigControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RigControl.Views"
        Title="RigControl" Width="1280" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <!-- Fondo transparente: así sigue el tema (claro/oscuro); solo una línea de separación. -->
        <Border Grid.Column="0" Padding="12,16" Background="Transparent" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="RigControl" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,16" />
                    <ListBox x:Name="Nav" SelectedIndex="0" BorderThickness="0" Background="Transparent">
                        <ListBoxItem Content="🎮  Monitor" />
                        <ListBoxItem Content="▶  Ejecución" IsEnabled="False" ToolTip="Próximamente: perfil activo, avión y acciones en directo" />
                        <ListBoxItem Content="📝  Perfiles" IsEnabled="False" ToolTip="Próximamente" />
                    </ListBox>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="8,0" FontSize="11" Opacity="0.5"
                           Text="Fase 1–3 · .NET 10 · WPF" />
            </DockPanel>
        </Border>

        <views:MonitorView Grid.Column="1" x:Name="Monitor" />
    </Grid>
</Window>
