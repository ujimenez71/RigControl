<Window x:Class="RigControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RigControl.Views"
        Title="RigControl" Icon="Assets/RigControl.ico" Width="1280" Height="900" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Window.Resources>
        <!-- Entrada del menú: icono + texto en mayúsculas; la elegida con barra y degradado verde HUD. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Height="44" Background="Transparent" Margin="0,1">
                            <Border x:Name="Fill" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4015804F" Offset="0" />
                                        <GradientStop Color="#0015804F" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource HudGreenBrush}" Opacity="0">
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="#3DFFA0" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                </Rectangle.Effect>
                            </Rectangle>
                            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16" Width="26" VerticalAlignment="Center" />
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontFamily="{StaticResource HeadingFont}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0DFFFFFF" />
                                <Setter Property="Foreground" Value="#DCE6EF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource HudGreenBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Hud" TargetType="Shape">
            <Setter Property="Stroke" Value="{StaticResource HudGreenBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="HudText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HudGreenBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================ menú lateral -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource PanelBorderBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0D1620" Offset="0" />
                    <GradientStop Color="#070C12" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,12,22">
                    <Image Source="Assets/Logo.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RIGCONTROL" FontFamily="{StaticResource HeadingFont}" FontSize="21" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="SIM RIG COMMAND" FontFamily="{StaticResource HeadingFont}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AmberBrush}" Margin="1,-1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Radar decorativo -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Grid Width="132" Height="132" Opacity="0.85">
                        <Ellipse Style="{StaticResource Hud}" Stroke="{StaticResource HudGreenDimBrush}" StrokeThickness="1" />
                        <Ellipse Style="{StaticResource Hud}" Stroke="{StaticResource HudGreenDimBrush}" StrokeThickness="1" Margin="22" Opacity="0.7" />
                        <Ellipse Style="{StaticResource Hud}" Stroke="{StaticResource HudGreenDimBrush}" StrokeThickness="1" Margin="44" Opacity="0.5" />
                        <Line X1="66" Y1="2" X2="66" Y2="130" Style="{StaticResource Hud}" Stroke="{StaticResource HudGreenDimBrush}" StrokeThickness="0.8" Opacity="0.5" />
                        <Line X1="2" Y1="66" X2="130" Y2="66" Style="{StaticResource Hud}" Stroke="{StaticResource HudGreenDimBrush}" StrokeThickness="0.8" Opacity="0.5" />
                        <!-- barrido -->
                        <Path Data="M66,66 L66,2 A64,64 0 0 1 111.25,20.75 Z" RenderTransformOrigin="0,0">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0.2">
                                    <GradientStop Color="#803DFFA0" Offset="0" />
                                    <GradientStop Color="#003DFFA0" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                            <Path.RenderTransform>
                                <RotateTransform x:Name="Sweep" CenterX="66" CenterY="66" />
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                        <Ellipse Width="5" Height="5" Fill="{StaticResource HudGreenBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="88,34,0,0" />
                        <Ellipse Width="4" Height="4" Fill="{StaticResource HudGreenBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="38,84,0,0" Opacity="0.7" />
                        <Ellipse Width="4" Height="4" Fill="{StaticResource AmberBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="96,92,0,0" />
                    </Grid>
                    <TextBlock Text="SISTEMAS EN LÍNEA" HorizontalAlignment="Center" Margin="0,10,0,0" Style="{StaticResource HudText}" Opacity="0.8" />
                    <TextBlock Text=".NET 10 · WPF" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Opacity="0.6" />
                </StackPanel>

                <ListBox x:Name="Nav" SelectedIndex="0" BorderThickness="0" Background="Transparent" Padding="0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Content="MONITOR" Tag="&#xE7FC;" />
                    <ListBoxItem Content="EJECUCIÓN" Tag="&#xE768;" />
                    <ListBoxItem Content="PERFILES" Tag="&#xE70F;" />
                    <ListBoxItem Content="HANGAR" Tag="&#xE709;" />
                    <ListBoxItem Content="MODS" Tag="&#xEA86;" />
                    <ListBoxItem Content="INSTANTÁNEAS" Tag="&#xE722;" />
                    <ListBoxItem Content="GRÁFICOS" Tag="&#xE7F4;" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================================================================ cabecera + pantalla -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="168" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ClipToBounds="True">
                <Image x:Name="BannerImage" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- legibilidad del título: oscuro a la izquierda y fundido con el fondo abajo -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F2070C12" Offset="0" />
                            <GradientStop Color="#B0070C12" Offset="0.32" />
                            <GradientStop Color="#00070C12" Offset="0.62" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00070C12" Offset="0.55" />
                            <GradientStop Color="#FF070C12" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- HUD: cinta de rumbo, escalera de cabeceo y vector de trayectoria -->
                <Canvas Width="420" Height="168" HorizontalAlignment="Right" Margin="0,0,40,0" Opacity="0.42" IsHitTestVisible="False">
                    <Canvas.Effect>
                        <DropShadowEffect Color="#3DFFA0" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                    </Canvas.Effect>
                    <Line X1="60" Y1="16" X2="360" Y2="16" Style="{StaticResource Hud}" />
                    <Path Style="{StaticResource Hud}" Data="M60,16 v6 M90,16 v4 M120,16 v6 M150,16 v4 M180,16 v6 M210,16 v4 M240,16 v6 M270,16 v4 M300,16 v6 M330,16 v4 M360,16 v6" />
                    <TextBlock Canvas.Left="53" Canvas.Top="24" Text="33" Style="{StaticResource HudText}" />
                    <TextBlock Canvas.Left="113" Canvas.Top="24" Text="34" Style="{StaticResource HudText}" />
                    <TextBlock Canvas.Left="173" Canvas.Top="24" Text="35" Style="{StaticResource HudText}" />
                    <TextBlock Canvas.Left="236" Canvas.Top="24" Text="N" Style="{StaticResource HudText}" FontWeight="Bold" />
                    <TextBlock Canvas.Left="293" Canvas.Top="24" Text="01" Style="{StaticResource HudText}" />
                    <TextBlock Canvas.Left="353" Canvas.Top="24" Text="02" Style="{StaticResource HudText}" />
                    <Path Style="{StaticResource Hud}" Fill="{StaticResource HudGreenBrush}" Data="M240,6 l-4,-5 h8 Z" />

                    <Path Style="{StaticResource Hud}" Data="M150,62 h46 v6 M284,62 h46 v6" />
                    <TextBlock Canvas.Left="128" Canvas.Top="55" Text="10" Style="{StaticResource HudText}" />
                    <TextBlock Canvas.Left="336" Canvas.Top="55" Text="10" Style="{StaticResource HudText}" />
                    <Path Style="{StaticResource Hud}" StrokeDashArray="3 3" Data="M150,140 h46 v-6 M284,140 h46 v-6" />
                    <TextBlock Canvas.Left="124" Canvas.Top="133" Text="-10" Style="{StaticResource HudText}" />
                    <TextBlock Canvas.Left="336" Canvas.Top="133" Text="-10" Style="{StaticResource HudText}" />

                    <Ellipse Canvas.Left="232" Canvas.Top="93" Width="16" Height="16" Style="{StaticResource Hud}" />
                    <Path Style="{StaticResource Hud}" Data="M214,101 h18 M248,101 h18 M240,93 v-9" />
                </Canvas>

                <StackPanel VerticalAlignment="Bottom" Margin="28,0,0,22">
                    <TextBlock x:Name="BannerCaption" FontFamily="{StaticResource HeadingFont}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AmberBrush}" />
                    <TextBlock x:Name="BannerTitle" FontFamily="{StaticResource HeadingFont}" FontSize="36" FontWeight="Bold" Foreground="White"
                               Margin="0,-2,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="BannerSubtitle" FontSize="13" Foreground="#C9D6E2" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <views:MonitorView x:Name="MonitorPage" />
                <views:RunView x:Name="RunPage" Visibility="Collapsed" />
                <views:ProfilesView x:Name="ProfilesPage" Visibility="Collapsed" />
                <views:HangarView x:Name="HangarPage" Visibility="Collapsed" />
                <views:ModsView x:Name="ModsPage" Visibility="Collapsed" />
                <views:SnapshotsView x:Name="SnapshotsPage" Visibility="Collapsed" />
                <views:GraphicsView x:Name="GraphicsPage" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
