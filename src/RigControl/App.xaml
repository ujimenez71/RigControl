<Application x:Class="RigControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="System">
    <!-- ThemeMode="System": estilo Fluent de Windows 11, claro u oscuro según el sistema. -->
    <Application.Resources>
        <!-- Registros compactos: una línea por entrada (el tema Fluent deja mucho margen en cada elemento). -->
        <Style x:Key="LogItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Application.Resources>
</Application>
